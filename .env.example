PORT=3000
NODE_ENV=development
SESSION_SECRET=your_long_random_session_secret_change_in_production

# Local PostgreSQL credentials (for local development)
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password
DB_NAME=sports_scheduler_dev
DB_TEST_NAME=sports_scheduler_test
DB_HOST=127.0.0.1
DB_PORT=5432

# Production / Hosted Database URL (Vercel Postgres, Neon, Supabase, etc.)
# In Vercel, set this under Project Settings > Environment Variables:
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require

