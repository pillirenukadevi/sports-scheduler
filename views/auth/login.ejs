<%- include('../layouts/header') %>

<div class="auth-container">
  <div class="card">
    <div class="auth-header">
      <h1 class="auth-title">Welcome Back</h1>
      <p class="auth-subtitle">Sign in to your Sports Scheduler account</p>
    </div>

    <form action="/login" method="POST">
      <div class="form-group">
        <label for="email" class="form-label">Email Address</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          class="form-control" 
          value="<%= typeof savedEmail !== 'undefined' ? savedEmail : '' %>"
          placeholder="your.email@example.com"
          required
          autofocus
        >
      </div>

      <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          class="form-control" 
          placeholder="••••••••"
          required
        >
      </div>

      <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top: 1.5rem;">
        Sign In
      </button>
    </form>

    <div class="auth-footer">
      Don't have an account? <a href="/signup">Create one now</a>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
