<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' : '' %>Sports Scheduler</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>">
</head>
<body>
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="brand">
        <div class="brand-icon">⚡</div>
        <span>Sports<span style="color: var(--primary);">Scheduler</span></span>
      </a>

      <ul class="nav-links">
        <% if (!currentUser) { %>
          <li><a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
          <li><a href="/login" class="nav-link <%= currentPath === '/login' ? 'active' : '' %>">Sign In</a></li>
          <li><a href="/signup" class="btn btn-primary btn-sm">Get Started</a></li>
        <% } else if (currentUser.role === 'admin') { %>
          <li><a href="/sports" class="nav-link <%= currentPath.startsWith('/sports') ? 'active' : '' %>">Manage Sports</a></li>
          <li><a href="/reports" class="nav-link <%= currentPath.startsWith('/reports') ? 'active' : '' %>">Reports & Analytics</a></li>
          <li class="user-info">
            <span class="role-badge badge-admin">Admin</span>
            <span class="user-name"><%= currentUser.first_name %></span>
          </li>
          <li><a href="/logout" class="btn btn-secondary btn-sm">Sign Out</a></li>
        <% } else { %>
          <li><a href="/sessions" class="nav-link <%= currentPath === '/sessions' ? 'active' : '' %>">Browse Sessions</a></li>
          <li><a href="/sessions/new" class="nav-link <%= currentPath === '/sessions/new' ? 'active' : '' %>">+ Create Session</a></li>
          <li class="user-info">
            <span class="role-badge badge-player">Player</span>
            <span class="user-name"><%= currentUser.first_name %></span>
          </li>
          <li><a href="/logout" class="btn btn-secondary btn-sm">Sign Out</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

  <main class="main-wrapper">
    <div class="alerts-container">
      <% if (success_msg && success_msg.length > 0) { %>
        <% success_msg.forEach(function(msg) { %>
          <div class="alert alert-success">
            <div class="alert-content">
              <span class="alert-icon">✓</span>
              <span><%= msg %></span>
            </div>
            <button class="alert-close" aria-label="Close">&times;</button>
          </div>
        <% }); %>
      <% } %>

      <% if (error_msg && error_msg.length > 0) { %>
        <% error_msg.forEach(function(msg) { %>
          <div class="alert alert-error">
            <div class="alert-content">
              <span class="alert-icon">⚠</span>
              <span><%= msg %></span>
            </div>
            <button class="alert-close" aria-label="Close">&times;</button>
          </div>
        <% }); %>
      <% } %>
    </div>
