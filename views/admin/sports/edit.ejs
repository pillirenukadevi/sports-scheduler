<%- include('../../layouts/header') %>

<div style="max-width: 600px; margin: 2rem auto;">
  <div style="margin-bottom: 1.5rem;">
    <a href="/sports" style="color: var(--text-muted); font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.35rem;">
      &larr; Back to Sports Catalog
    </a>
  </div>

  <div class="card">
    <div style="margin-bottom: 1.75rem;">
      <h1 style="font-size: 1.85rem; margin-bottom: 0.4rem;">Edit Sport: <%= sport.title %></h1>
      <p style="color: var(--text-muted); font-size: 0.925rem;">
        Modify the title or description for this sport category.
      </p>
    </div>

    <form action="/sports/<%= sport.id %>" method="POST" novalidate>
      <div class="form-group">
        <label for="title" class="form-label">Sport Title *</label>
        <input 
          type="text" 
          id="title" 
          name="title" 
          class="form-control" 
          value="<%= sport.title %>"
          required
          autofocus
        >
      </div>

      <div class="form-group">
        <label for="description" class="form-label">Description &amp; Guidelines (Optional)</label>
        <textarea 
          id="description" 
          name="description" 
          class="form-control" 
          rows="4"
        ><%= sport.description || '' %></textarea>
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 2rem;">
        <button type="submit" class="btn btn-primary btn-full">
          Save Changes
        </button>
        <a href="/sports" class="btn btn-secondary" style="flex: 0 0 auto;">
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>

<%- include('../../layouts/footer') %>
