<%- include('../../layouts/header') %>

<% 
  const isCreator = currentUser && session.creator_id === currentUser.id;
  const isJoined = currentUser && session.players && session.players.some(p => p.id === currentUser.id);
  const playerCount = session.players ? session.players.length : 0;
  const isFull = playerCount >= session.max_players;
  const formattedDate = new Date(session.date + 'T00:00:00').toLocaleDateString(undefined, {
    weekday: 'long', month: 'long', day: 'numeric', year: 'numeric'
  });
%>

<div style="max-width: 900px; margin: 1.5rem auto;">
  <div style="margin-bottom: 1.5rem;">
    <a href="/sessions" style="color: var(--text-muted); font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.35rem;">
      &larr; Back to All Sessions
    </a>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 340px; gap: 1.75rem; align-items: start;">
    
    <!-- Left Column: Match Details -->
    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem;">
        <div>
          <span class="role-badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); margin-bottom: 0.5rem;">
            <%= session.sport ? session.sport.title : 'Sport' %>
          </span>
          <h1 style="font-size: 2rem; color: #fff; line-height: 1.2;"><%= session.venue %></h1>
        </div>
        
        <div>
          <% if (isCreator) { %>
            <span class="role-badge" style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.3);">
              You are Organizer
            </span>
          <% } else if (isJoined) { %>
            <span class="role-badge" style="background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.3);">
              You are Joined
            </span>
          <% } %>
        </div>
      </div>

      <% if (session.sport && session.sport.description) { %>
        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem;">
          <strong style="color: #cbd5e1; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.35rem;">Sport Info &amp; Rules:</strong>
          <p style="color: var(--text-muted); font-size: 0.9rem;"><%= session.sport.description %></p>
        </div>
      <% } %>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
        <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-dim); margin-bottom: 0.25rem;">Date</div>
          <div style="font-size: 1rem; font-weight: 700; color: #fff;"><%= formattedDate %></div>
        </div>
        <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-dim); margin-bottom: 0.25rem;">Time</div>
          <div style="font-size: 1rem; font-weight: 700; color: #fff;"><%= session.time.substring(0, 5) %></div>
        </div>
        <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-dim); margin-bottom: 0.25rem;">Organizer</div>
          <div style="font-size: 1rem; font-weight: 700; color: #fff;"><%= session.creator ? session.creator.fullName : 'Player' %></div>
        </div>
        <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-dim); margin-bottom: 0.25rem;">Capacity</div>
          <div style="font-size: 1rem; font-weight: 700; color: <%= isFull ? '#ef4444' : '#34d399' %>;">
            <%= playerCount %> / <%= session.max_players %> Spots
          </div>
        </div>
      </div>

      <!-- Action Area -->
      <div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
        <% if (currentUser && currentUser.role === 'admin') { %>
          <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 8px; padding: 0.85rem 1rem; color: #fbbf24; font-size: 0.875rem;">
            🛡️ You are signed in as an <strong>Administrator</strong>. Admins manage sports catalog and reports, but cannot join or create player matches.
          </div>
        <% } else if (currentUser && currentUser.role === 'player') { %>
          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <% if (!isCreator && !isJoined && !isFull) { %>
              <form action="/sessions/<%= session.id %>/join" method="POST">
                <button type="submit" class="btn btn-primary btn-lg">
                  Join This Session
                </button>
              </form>
            <% } else if (!isCreator && isJoined) { %>
              <form action="/sessions/<%= session.id %>/leave" method="POST">
                <button 
                  type="submit" 
                  class="btn btn-danger"
                  data-confirm="Are you sure you want to leave this session?"
                >
                  Leave Session
                </button>
              </form>
            <% } else if (isCreator) { %>
              <form action="/sessions/<%= session.id %>/cancel" method="POST">
                <button 
                  type="submit" 
                  class="btn btn-danger"
                  data-confirm="Are you sure you want to cancel this entire match? All joined players will be notified."
                >
                  Cancel &amp; Delete Session
                </button>
              </form>
            <% } else if (isFull && !isJoined) { %>
              <button class="btn btn-secondary" disabled style="opacity: 0.6; cursor: not-allowed;">
                Session is Full (<%= playerCount %> / <%= session.max_players %>)
              </button>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right Column: Player Roster -->
    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
        <h2 style="font-size: 1.25rem; color: #fff;">Player Roster</h2>
        <span class="role-badge" style="background: rgba(255, 255, 255, 0.08); color: #cbd5e1;">
          <%= playerCount %> Joined
        </span>
      </div>

      <% if (!session.players || session.players.length === 0) { %>
        <p style="color: var(--text-dim); font-size: 0.9rem; text-align: center; padding: 2rem 0;">
          No players have joined this match yet.
        </p>
      <% } else { %>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem;">
          <% session.players.forEach((player, index) => { %>
            <% const isOrganizer = player.id === session.creator_id; %>
            <li style="display: flex; align-items: center; justify-content: space-between; padding: 0.65rem 0.85rem; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 8px;">
              <div style="display: flex; align-items: center; gap: 0.65rem;">
                <div style="width: 32px; height: 32px; border-radius: 50%; background: <%= isOrganizer ? 'linear-gradient(135deg, #6366f1, #06b6d4)' : 'linear-gradient(135deg, #10b981, #06b6d4)' %>; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; color: #000;">
                  <%= player.first_name ? player.first_name.charAt(0).toUpperCase() : 'P' %>
                </div>
                <div>
                  <div style="font-size: 0.9rem; font-weight: 600; color: #fff;">
                    <%= player.fullName %>
                  </div>
                  <div style="font-size: 0.75rem; color: var(--text-dim);">
                    <%= player.email %>
                  </div>
                </div>
              </div>

              <% if (isOrganizer) { %>
                <span class="role-badge" style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc; font-size: 0.7rem;">
                  Host
                </span>
              <% } else { %>
                <span style="font-size: 0.75rem; color: var(--text-dim);">
                  #<%= index + 1 %>
                </span>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

  </div>
</div>

<%- include('../../layouts/footer') %>
