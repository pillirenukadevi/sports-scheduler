<%- include('../../layouts/header') %>

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <% if (selectedTab === 'my') { %>
      <h1 style="font-size: 2rem; margin-bottom: 0.25rem;">🎯 Matches Hosted By Me</h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">
        Manage, review rosters, or cancel sessions that you organized.
      </p>
    <% } else if (selectedTab === 'joined') { %>
      <h1 style="font-size: 2rem; margin-bottom: 0.25rem;">🏃 Matches Joined By Me</h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">
        View upcoming game schedules where you are enrolled as a player.
      </p>
    <% } else { %>
      <h1 style="font-size: 2rem; margin-bottom: 0.25rem;">Browse Sports Sessions</h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">
        Find upcoming matches, search games by sport or venue, and join open rosters.
      </p>
    <% } %>
  </div>
  <% if (currentUser && currentUser.role === 'player') { %>
    <a href="/sessions/new" class="btn btn-primary">
      <span>+ Host a Session</span>
    </a>
  <% } %>
</div>

<!-- Search Bar Component -->
<form action="/sessions" method="GET" class="search-container" id="sessionSearchForm">
  <div class="search-input-wrapper">
    <span class="search-icon">🔍</span>
    <input 
      type="text" 
      name="search" 
      id="sessionSearchInput"
      class="search-input" 
      placeholder="Search for any game (e.g. Cricket, Basketball, Football, Tennis) or venue location..."
      value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
      autocomplete="off"
    >
    <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
      <a href="/sessions<%= selectedSport ? '?sport=' + selectedSport : (selectedTab ? '?filter=' + selectedTab : '') %>" class="search-clear-btn" title="Clear search">&times;</a>
    <% } %>
  </div>
  <% if (selectedSport) { %>
    <input type="hidden" name="sport" value="<%= selectedSport %>">
  <% } %>
  <% if (selectedTab) { %>
    <input type="hidden" name="filter" value="<%= selectedTab %>">
  <% } %>
</form>

<!-- Sports Filter Bar -->
<div style="display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.75rem; margin-bottom: 1.75rem;">
  <a 
    href="/sessions<%= typeof searchQuery !== 'undefined' && searchQuery ? '?search=' + encodeURIComponent(searchQuery) : (selectedTab ? '?filter=' + selectedTab : '') %>" 
    class="btn btn-sm <%= !selectedSport ? 'btn-primary' : 'btn-secondary' %>"
  >
    All Sports
  </a>
  <% if (sports && sports.length > 0) { %>
    <% sports.forEach(sport => { %>
      <a 
        href="/sessions?sport=<%= sport.id %><%= typeof searchQuery !== 'undefined' && searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>" 
        class="btn btn-sm <%= selectedSport == sport.id ? 'btn-primary' : 'btn-secondary' %>"
      >
        <%= sport.title %>
      </a>
    <% }) %>
  <% } %>
</div>

<div id="noLiveResultsNotice" class="card" style="display: none; text-align: center; padding: 3rem 1.5rem; margin-bottom: 1.5rem;">
  <div style="font-size: 3rem; margin-bottom: 0.75rem;">🔍</div>
  <h2 style="font-size: 1.35rem; margin-bottom: 0.5rem;">No Matches Found</h2>
  <p style="color: var(--text-muted);">
    No sessions match your search keyword "<span id="searchedTermText" style="color: #fff; font-weight: 600;"></span>".
  </p>
</div>

<% if (!sessions || sessions.length === 0) { %>
  <div class="card" style="text-align: center; padding: 4rem 1.5rem;">
    <div style="font-size: 3.5rem; margin-bottom: 1rem;">📅</div>
    <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem;">No Matching Sessions Found</h2>
    <p style="color: var(--text-muted); max-width: 450px; margin: 0 auto 1.5rem;">
      <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
        No sessions found matching "<%= searchQuery %>". Try searching for another game like Cricket, Basketball, Soccer, or Tennis!
      <% } else if (selectedTab === 'my') { %>
        You haven't scheduled any sessions yet. Take the initiative and host a game!
      <% } else if (selectedTab === 'joined') { %>
        You haven't joined any upcoming sessions yet. Browse open games and jump in!
      <% } else { %>
        There are currently no sessions scheduled under this filter.
      <% } %>
    </p>
    <% if (currentUser && currentUser.role === 'player') { %>
      <a href="/sessions/new" class="btn btn-primary">Schedule a New Match</a>
    <% } %>
  </div>
<% } else { %>
  <div id="sessionsCardsGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 1.5rem;">
    <% sessions.forEach(session => { %>
      <% 
        const isCreator = currentUser && session.creator_id === currentUser.id;
        const isJoined = currentUser && session.players && session.players.some(p => p.id === currentUser.id);
        const playerCount = session.players ? session.players.length : 0;
        const isFull = playerCount >= session.max_players;
        const formattedDate = new Date(session.date + 'T00:00:00').toLocaleDateString(undefined, {
          weekday: 'short', month: 'short', day: 'numeric', year: 'numeric'
        });
        const sportTitle = session.sport ? session.sport.title : 'Sport';
        const isClosed = session.isRegistrationClosed;
        const closeDateObj = session.closingDateTime;
        const formattedClose = closeDateObj.toLocaleDateString(undefined, {
          month: 'short', day: 'numeric'
        }) + ' at ' + closeDateObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      %>
      <div 
        class="card session-item-card" 
        data-sport="<%= sportTitle.toLowerCase() %>"
        data-venue="<%= session.venue.toLowerCase() %>"
        data-creator="<%= session.creator ? session.creator.first_name.toLowerCase() : '' %>"
        style="display: flex; flex-direction: column; justify-content: space-between; position: relative;"
      >
        <div>
          <!-- Header: Sport & Badges -->
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
            <div>
              <span class="role-badge" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.35); margin-bottom: 0.4rem;">
                <%= sportTitle %>
              </span>
              <h3 style="font-size: 1.25rem; color: #fff;"><%= session.venue %></h3>
            </div>
            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem;">
              <% if (isCreator) { %>
                <span class="role-badge" style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.3);">
                  Organizer
                </span>
              <% } else if (isJoined) { %>
                <span class="role-badge" style="background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.35);">
                  Joined
                </span>
              <% } %>
              <% if (isClosed) { %>
                <span class="role-badge" style="background: rgba(239, 68, 68, 0.15); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.3);">
                  Join Closed
                </span>
              <% } else if (isFull) { %>
                <span class="role-badge" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">
                  Full
                </span>
              <% } %>
            </div>
          </div>

          <!-- Match Meta Details -->
          <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.25rem; font-size: 0.9rem; color: var(--text-muted);">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span>🗓️</span>
              <span><strong>Match:</strong> <%= formattedDate %> at <%= session.time.substring(0, 5) %></span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem; color: <%= isClosed ? '#ef4444' : '#cbd5e1' %>;">
              <span>⏳</span>
              <span>
                <strong>Join Closes:</strong> <%= formattedClose %>
              </span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span>👤</span>
              <span>Hosted by <strong style="color: #fff;"><%= session.creator ? session.creator.first_name : 'Player' %></strong></span>
            </div>
          </div>

          <!-- Dedicated Address & Location Section -->
          <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 0.65rem 0.85rem; margin-bottom: 1.15rem;">
            <div style="display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.85rem;">
              <span style="font-size: 1.1rem; line-height: 1.2; flex-shrink: 0; color: #f87171;">📍</span>
              <div style="flex: 1; min-width: 0;">
                <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-dim); font-weight: 700; letter-spacing: 0.05em; margin-bottom: 0.15rem;">
                  Address &amp; Location
                </div>
                <div style="font-weight: 600; color: #fff; font-size: 0.9rem;">
                  <%= session.venue %>
                </div>
                <div style="font-size: 0.8rem; color: #cbd5e1; word-break: break-word; margin-top: 0.2rem; line-height: 1.4;">
                  <% if (session.address && session.address.trim()) { %>
                    <%= session.address %>
                  <% } else { %>
                    <span style="color: var(--text-dim); font-style: italic;">Standard ground address at venue. Check details for directions.</span>
                  <% } %>
                </div>
                <a 
                  href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(session.venue + (session.address ? ' ' + session.address : '')) %>" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  style="display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.75rem; color: #f87171; text-decoration: none; margin-top: 0.35rem; font-weight: 600;"
                >
                  🗺️ Open in Google Maps &rarr;
                </a>
              </div>
            </div>
          </div>

          <!-- Roster Capacity Bar -->
          <div style="margin-bottom: 1.25rem;">
            <div style="display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 0.35rem;">
              <span style="color: var(--text-dim);">Roster Capacity</span>
              <span style="font-weight: 700; color: <%= isFull ? '#ef4444' : '#f87171' %>;">
                <%= playerCount %> / <%= session.max_players %> Players
              </span>
            </div>
            <div style="height: 6px; background: rgba(255, 255, 255, 0.1); border-radius: var(--radius-full); overflow: hidden;">
              <div style="height: 100%; width: <%= Math.min(100, (playerCount / session.max_players) * 100) %>%; background: linear-gradient(90deg, #ef4444, #f97316); transition: width 0.3s ease;"></div>
            </div>
          </div>

          <!-- Prominent Players Added Section for Hosted Match -->
          <% if (isCreator) { %>
            <% const otherPlayers = session.players ? session.players.filter(p => p.id !== session.creator_id) : []; %>
            <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 0.75rem 0.9rem; margin-bottom: 1.25rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                <span style="font-size: 0.8rem; font-weight: 700; color: #cbd5e1;">
                  👥 Players Added: <span style="color: #fff;"><%= playerCount %></span> / <%= session.max_players %>
                </span>
                <span style="font-size: 0.75rem; color: <%= isFull ? '#ef4444' : '#f87171' %>; font-weight: 600;">
                  <%= Math.max(0, session.max_players - playerCount) %> spots left
                </span>
              </div>
              <% if (otherPlayers.length === 0) { %>
                <div style="font-size: 0.78rem; color: var(--text-dim); font-style: italic;">
                  No other players have joined yet. Waiting for players...
                </div>
              <% } else { %>
                <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.35rem;">
                  <% session.players.forEach(p => { %>
                    <span style="font-size: 0.725rem; padding: 0.2rem 0.5rem; background: <%= p.id === session.creator_id ? 'rgba(239, 68, 68, 0.25)' : 'rgba(255, 255, 255, 0.08)' %>; border-radius: 4px; color: #fff; border: 1px solid rgba(255, 255, 255, 0.1);">
                      <%= p.first_name %> <%= p.id === session.creator_id ? '(Host)' : '' %>
                    </span>
                  <% }) %>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>

        <!-- Footer Actions -->
        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-color); padding-top: 1rem;">
          <a href="/sessions/<%= session.id %>" class="btn btn-secondary btn-sm" style="flex: 1; text-align: center;">
            View Details &amp; Roster
          </a>

          <% if (currentUser && currentUser.role === 'player') { %>
            <% if (!isCreator && !isJoined && !isFull) { %>
              <form action="/sessions/<%= session.id %>/join" method="POST" style="margin-left: 0.5rem;">
                <button type="submit" class="btn btn-primary btn-sm">Join Match</button>
              </form>
            <% } else if (isCreator) { %>
              <form action="/sessions/<%= session.id %>/cancel" method="POST" style="margin-left: 0.5rem;">
                <button 
                  type="submit" 
                  class="btn btn-danger btn-sm"
                  data-confirm="Are you sure you want to cancel this session? This action cannot be undone."
                >
                  Cancel
                </button>
              </form>
            <% } %>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<!-- Client-side instant live filtering script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('sessionSearchInput');
    const cards = document.querySelectorAll('.session-item-card');
    const notice = document.getElementById('noLiveResultsNotice');
    const termText = document.getElementById('searchedTermText');
    const cardsGrid = document.getElementById('sessionsCardsGrid');

    if (searchInput && cards.length > 0) {
      searchInput.addEventListener('input', (e) => {
        const val = e.target.value.trim().toLowerCase();
        let visibleCount = 0;

        cards.forEach((card) => {
          const sport = card.getAttribute('data-sport') || '';
          const venue = card.getAttribute('data-venue') || '';
          const creator = card.getAttribute('data-creator') || '';

          if (sport.includes(val) || venue.includes(val) || creator.includes(val)) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (notice && termText) {
          if (visibleCount === 0 && val.length > 0) {
            termText.textContent = e.target.value;
            notice.style.display = 'block';
          } else {
            notice.style.display = 'none';
          }
        }
      });
    }
  });
</script>

<%- include('../../layouts/footer') %>
